# Copy this file to ".env" and fill in the value. The .env file is git-ignored,
# so anything you put there stays on your computer and is never committed.

# A GitHub Personal Access Token, used only by `npm run push`.
# Create one at https://github.com/settings/tokens?type=beta
# Give it access to the "mesura" repository, with Contents: Read and write.
GITHUB_TOKEN=
